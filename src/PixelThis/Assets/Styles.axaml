<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Section header label -->
    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,6" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>

    <!-- Tool rail buttons -->
    <Style Selector="ToggleButton.tool">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2C3044" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Background" Value="#232737" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#373C4E" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    </Style>

</Styles>
